# Copy to .env and fill in real values. .env is git-ignored.
DB_NAME=liftlog
DB_USER=liftlog
DB_PASSWORD=change-me
DB_PORT=5433
# At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# League tracker: personal key from developer.riotgames.com (leave empty to switch the tracker off)
RIOT_API_KEY=
# Local development without a key: generated League data. Never together with RIOT_API_KEY.
RIOT_FAKE=false

# Production only: public hostname Caddy requests a certificate for
DOMAIN=api.example.com
